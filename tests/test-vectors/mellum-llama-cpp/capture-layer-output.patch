+static bool dump_mellum_tensor(struct ggml_tensor * tensor, bool ask, void *) {
+    const char * tensor_name = std::getenv("MELLUM_DUMP_TENSOR");
+    const char * output_path = std::getenv("MELLUM_DUMP_PATH");
+    if (!tensor_name || !output_path || std::strcmp(tensor->name, tensor_name) != 0) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+
+    const size_t bytes = ggml_nbytes(tensor);
+    std::vector<uint8_t> data(bytes);
+    if (ggml_backend_buffer_is_host(tensor->buffer)) {
+        std::memcpy(data.data(), tensor->data, bytes);
+    } else {
+        ggml_backend_tensor_get(tensor, data.data(), 0, bytes);
+    }
+    FILE * file = std::fopen(output_path, "wb");
+    if (!file) {
+        return false;
+    }
+    const bool complete = std::fwrite(data.data(), 1, bytes, file) == bytes;
+    const bool closed = std::fclose(file) == 0;
+    return complete && closed;
+}
